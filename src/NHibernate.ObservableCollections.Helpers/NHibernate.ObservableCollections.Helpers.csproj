<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\Build.props" />

  <PropertyGroup>
    <TargetFrameworks>net6.0-windows;net48</TargetFrameworks>
    <!--
        https://learn.microsoft.com/en-us/dotnet/core/tools/sdk-errors/netsdk1100
    -->
    <EnableWindowsTargeting Condition="!$([MSBuild]::IsOSPlatform('Windows'))">true</EnableWindowsTargeting>

    <UseWPF>true</UseWPF>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!--
    https://learn.microsoft.com/en-us/dotnet/standard/library-guidance/nuget
  -->
  <PropertyGroup>
    <AssemblyName>NHibernate.ObservableCollections.Helpers</AssemblyName>
    <RootNamespace>NHibernate.ObservableCollections.Helpers</RootNamespace>

    <Title>NHibernate.ObservableCollections.Helpers</Title>
    <Description>NHibernate.ObservableCollections.Helpers</Description>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))">
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net48'))">
  </ItemGroup>

</Project>
