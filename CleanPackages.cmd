@ECHO OFF


SET OUTPUT_FOLDER_PATH=bin
SET TEMPORARY_OUTPUT_FOLDER_PATH=obj

dotnet clean "%1" --configuration Debug
dotnet clean "%1" --configuration Release

IF EXIST "%OUTPUT_FOLDER_PATH%" RMDIR "%OUTPUT_FOLDER_PATH%" /S /Q
IF EXIST "%TEMPORARY_OUTPUT_FOLDER_PATH%" RMDIR "%TEMPORARY_OUTPUT_FOLDER_PATH%" /S /Q
